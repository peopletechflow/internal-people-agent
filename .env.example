# fixture (default, example data, embedded Postgres) or live
MODE=fixture
FIXTURE_USER=emp_ava

# --- live mode (Workday MCP upstream) ---
# Postgres for durable previews, commits, consents, decision chains and audit (required in live)
# DATABASE_URL=postgres://USER@127.0.0.1:5432/internal_people_agent
# Upstream Workday MCP server (Streamable HTTP, https; http only on loopback)
# WORKDAY_MCP_URL=https://REPLACE/mcp
# File holding YOUR OWN per-user access token for that server (chmod 600). Never a shared token.
# WORKDAY_MCP_TOKEN_FILE=/path/to/token
# Tenant capability mapping (see examples/workday-mcp-mapping.example.json)
# WORKDAY_MCP_MAPPING_PATH=/path/to/mapping.json
# Roles per tenant:worker (see examples/role-map.example.json)
# ROLE_MAP_PATH=/path/to/role-map.json
# Optional kill switches (comma separated)
# DISABLED_TOOLS=commit_pbp_handoff
# DISABLED_CAPABILITIES=transfer_submit

# --- decision chain intent classifier ---
# Default: client (Claude passes intent). Optional: jev (TypeSafe System One). Sends only the question text.
# DECISION_CLASSIFIER=jev
# TYPESAFE_API_KEY_FILE=/path/to/typesafe-key   (chmod 600)
# TYPESAFE_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0.6
