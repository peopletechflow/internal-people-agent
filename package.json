{
  "name": "internal-people-agent",
  "version": "0.2.0",
  "description": "Internal People Agent | Workday MCP: task-shaped MCP tools for an employee's own benefits, equity, policy answers, team-transfer requests and PBP handoffs. Fixture-tested; live connectors fail closed.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "internal-people-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@typesafe-ai/sdk": "0.7.0",
    "pg": "^8.23.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
